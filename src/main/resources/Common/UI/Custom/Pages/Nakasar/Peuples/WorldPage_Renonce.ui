$C = "../../../Common.ui";
$Sounds = "../../../Sounds.ui";

// Généré par tools/generate_world_tab.py (thème Renonce) : ne pas modifier à la main.

@Accent = #8fd0ea;
@Section = LabelStyle(FontSize: 13, RenderBold: true, RenderUppercase: true, TextColor: #bfe2ee, VerticalAlignment: Center);
@Small = LabelStyle(FontSize: 12, TextColor: #96a9be, VerticalAlignment: Center);
@SmallWrap = LabelStyle(FontSize: 12, TextColor: #96a9be, Wrap: true);
@Tiny = LabelStyle(FontSize: 11, TextColor: #a8b6c4, VerticalAlignment: Center);
@Head = LabelStyle(FontSize: 11, RenderBold: true, RenderUppercase: true, TextColor: #96a9be, VerticalAlignment: Center);
@MapButton = (Default: (Background: (Color: #000000(0.01))), Hovered: (Background: (Color: #ffffff(0.16))), Pressed: (Background: (Color: #ffffff(0.26))), Sounds: $Sounds.@ButtonsLight);
@RowButton = (Default: (Background: (Color: #0c151e(0.7))), Hovered: (Background: (Color: #1b2a38(0.85))), Pressed: (Background: (Color: #22364a(0.9))), Sounds: $Sounds.@ButtonsLight);

@Card = Group {
  Background: (Color: #0c151e(0.7));
};

@Bar = ProgressBar {
  Background: "../../../Common/ProgressBar.png";
  BarTexturePath: "Board/Bar_Renonce.png";
  Value: 0;
};

$C.@PageOverlay {
  LayoutMode: Middle;

  $C.@DecoratedContainer {
    Anchor: (Width: 1060, Height: 840);

    #Title {
      Group {
        LayoutMode: Center;
        Group #TitleEmblem { Anchor: (Width: 26, Height: 26, Right: 8); Background: (TexturePath: "../../Memories/categories/Outlander.png", Color: #8fd0ea); }
        Label #PageTitle { Style: (...$C.@TitleStyle, FontSize: 16, TextColor: #bfe2ee); }
      }
    }

    #Content {
      LayoutMode: Top;
      Padding: (Full: 17, Top: 12);
      Group #Tabs {
        LayoutMode: Left;
        Anchor: (Height: 38);
        Group #TabBoard {
          LayoutMode: Full;
          Anchor: (Width: 52, Height: 38, Right: 6);
          Group #TabBoardOff {
            LayoutMode: Full;
            Anchor: (Full: 0);
            Visible: true;
            Button #TabBoardButton {
              Anchor: (Full: 0);
              Style: $C.@SecondaryButtonStyle;
              LayoutMode: CenterMiddle;
              TextTooltipStyle: $C.@DefaultTextTooltipStyle;
              Group { Anchor: (Width: 24, Height: 24); Background: (TexturePath: "Board/Tab_Board.png", Color: #c9d1d9); }
            }
          }
          Group #TabBoardOn {
            LayoutMode: CenterMiddle;
            Anchor: (Full: 0);
            Background: (Color: #8fd0ea);
            Visible: false;
            Group { Anchor: (Width: 24, Height: 24); Background: (TexturePath: "Board/Tab_Board.png", Color: #10180e); }
          }
        }
        Group #TabBuild {
          LayoutMode: Full;
          Anchor: (Width: 52, Height: 38, Right: 6);
          Group #TabBuildOff {
            LayoutMode: Full;
            Anchor: (Full: 0);
            Visible: true;
            Button #TabBuildButton {
              Anchor: (Full: 0);
              Style: $C.@SecondaryButtonStyle;
              LayoutMode: CenterMiddle;
              TextTooltipStyle: $C.@DefaultTextTooltipStyle;
              Group { Anchor: (Width: 24, Height: 24); Background: (TexturePath: "Board/Tab_Build.png", Color: #c9d1d9); }
            }
          }
          Group #TabBuildOn {
            LayoutMode: CenterMiddle;
            Anchor: (Full: 0);
            Background: (Color: #8fd0ea);
            Visible: false;
            Group { Anchor: (Width: 24, Height: 24); Background: (TexturePath: "Board/Tab_Build.png", Color: #10180e); }
          }
        }
        Group #TabWorld {
          LayoutMode: Full;
          Anchor: (Width: 52, Height: 38, Right: 6);
          Group #TabWorldOff {
            LayoutMode: Full;
            Anchor: (Full: 0);
            Visible: false;
            Button #TabWorldButton {
              Anchor: (Full: 0);
              Style: $C.@SecondaryButtonStyle;
              LayoutMode: CenterMiddle;
              TextTooltipStyle: $C.@DefaultTextTooltipStyle;
              Group { Anchor: (Width: 24, Height: 24); Background: (TexturePath: "Board/Tab_World.png", Color: #c9d1d9); }
            }
          }
          Group #TabWorldOn {
            LayoutMode: CenterMiddle;
            Anchor: (Full: 0);
            Background: (Color: #8fd0ea);
            Visible: true;
            Group { Anchor: (Width: 24, Height: 24); Background: (TexturePath: "Board/Tab_World.png", Color: #10180e); }
          }
        }
        Group #TabDomain {
          LayoutMode: Full;
          Anchor: (Width: 52, Height: 38, Right: 6);
          Group #TabDomainOff {
            LayoutMode: Full;
            Anchor: (Full: 0);
            Visible: true;
            Button #TabDomainButton {
              Anchor: (Full: 0);
              Style: $C.@SecondaryButtonStyle;
              LayoutMode: CenterMiddle;
              TextTooltipStyle: $C.@DefaultTextTooltipStyle;
              Group { Anchor: (Width: 24, Height: 24); Background: (TexturePath: "Board/Tab_Domain.png", Color: #c9d1d9); }
            }
          }
          Group #TabDomainOn {
            LayoutMode: CenterMiddle;
            Anchor: (Full: 0);
            Background: (Color: #8fd0ea);
            Visible: false;
            Group { Anchor: (Width: 24, Height: 24); Background: (TexturePath: "Board/Tab_Domain.png", Color: #10180e); }
          }
        }
        Group #TabTrade {
          LayoutMode: Full;
          Anchor: (Width: 52, Height: 38, Right: 6);
          Group #TabTradeOff {
            LayoutMode: Full;
            Anchor: (Full: 0);
            Visible: true;
            Button #TabTradeButton {
              Anchor: (Full: 0);
              Style: $C.@SecondaryButtonStyle;
              LayoutMode: CenterMiddle;
              TextTooltipStyle: $C.@DefaultTextTooltipStyle;
              Group { Anchor: (Width: 24, Height: 24); Background: (TexturePath: "Board/Tab_Trade.png", Color: #c9d1d9); }
            }
          }
          Group #TabTradeOn {
            LayoutMode: CenterMiddle;
            Anchor: (Full: 0);
            Background: (Color: #8fd0ea);
            Visible: false;
            Group { Anchor: (Width: 24, Height: 24); Background: (TexturePath: "Board/Tab_Trade.png", Color: #10180e); }
          }
        }
        Group #TabPeople {
          LayoutMode: Full;
          Anchor: (Width: 52, Height: 38, Right: 6);
          Group #TabPeopleOff {
            LayoutMode: Full;
            Anchor: (Full: 0);
            Visible: true;
            Button #TabPeopleButton {
              Anchor: (Full: 0);
              Style: $C.@SecondaryButtonStyle;
              LayoutMode: CenterMiddle;
              TextTooltipStyle: $C.@DefaultTextTooltipStyle;
              Group { Anchor: (Width: 24, Height: 24); Background: (TexturePath: "Board/Tab_People.png", Color: #c9d1d9); }
            }
          }
          Group #TabPeopleOn {
            LayoutMode: CenterMiddle;
            Anchor: (Full: 0);
            Background: (Color: #8fd0ea);
            Visible: false;
            Group { Anchor: (Width: 24, Height: 24); Background: (TexturePath: "Board/Tab_People.png", Color: #10180e); }
          }
        }
        Group {
          LayoutMode: Full;
          FlexWeight: 1;
          Padding: (Left: 8);
          Label #TabNameBoard { Anchor: (Full: 0); Style: (FontSize: 16, RenderBold: true, RenderUppercase: true, TextColor: #8fd0ea, VerticalAlignment: Center); Text: ""; Visible: false; }
          Label #TabNameBuild { Anchor: (Full: 0); Style: (FontSize: 16, RenderBold: true, RenderUppercase: true, TextColor: #8fd0ea, VerticalAlignment: Center); Text: ""; Visible: false; }
          Label #TabNameWorld { Anchor: (Full: 0); Style: (FontSize: 16, RenderBold: true, RenderUppercase: true, TextColor: #8fd0ea, VerticalAlignment: Center); Text: ""; Visible: true; }
          Label #TabNameDomain { Anchor: (Full: 0); Style: (FontSize: 16, RenderBold: true, RenderUppercase: true, TextColor: #8fd0ea, VerticalAlignment: Center); Text: ""; Visible: false; }
          Label #TabNameTrade { Anchor: (Full: 0); Style: (FontSize: 16, RenderBold: true, RenderUppercase: true, TextColor: #8fd0ea, VerticalAlignment: Center); Text: ""; Visible: false; }
          Label #TabNamePeople { Anchor: (Full: 0); Style: (FontSize: 16, RenderBold: true, RenderUppercase: true, TextColor: #8fd0ea, VerticalAlignment: Center); Text: ""; Visible: false; }
        }
        Label #Clock { Anchor: (Width: 110); Style: (FontSize: 14, RenderBold: true, TextColor: #96a9be, HorizontalAlignment: End, VerticalAlignment: Center); Text: ""; }
      }
      Group { Anchor: (Height: 2, Bottom: 12); Background: (Color: #8fd0ea); }
      Group {
        LayoutMode: Left;
        Anchor: (Height: 56, Bottom: 8);
        @Card #St0 {
          LayoutMode: Full;
          Anchor: (Right: 8);
          FlexWeight: 1;
          Group #StWarn0 { Anchor: (Full: 0); Background: (Color: #ef6f5e(0.16)); Visible: false; }
          Group {
            LayoutMode: Top;
            Anchor: (Full: 0);
            Padding: (Horizontal: 10, Vertical: 4);
            Label #StLabel0 { Anchor: (Height: 15); Style: @Head; Text: ""; }
            Label #StValue0 { Anchor: (Height: 20); Style: (FontSize: 16, RenderBold: true, TextColor: #e6edf3, VerticalAlignment: Center); Text: ""; }
            Label #StSub0 { Anchor: (Height: 14); Style: @Tiny; Text: ""; }
          }
