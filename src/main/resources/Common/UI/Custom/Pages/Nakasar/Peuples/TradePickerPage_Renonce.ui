          Group #GradeLuxuryOn {
            LayoutMode: Full;
            Anchor: (Full: 0);
            Background: (Color: #8fd0ea);
            Visible: false;
            Label #GradeLuxuryLabel { Anchor: (Full: 0); Style: (FontSize: 12, RenderBold: true, TextColor: #10180e, HorizontalAlignment: Center, VerticalAlignment: Center); Text: ""; }
          }
        }
        Label #PickHint { Style: (FontSize: 12, TextColor: #96a9be, HorizontalAlignment: End, VerticalAlignment: Center); Text: ""; FlexWeight: 1; }
      }
      Label #NoPick { Anchor: (Height: 40); Style: (FontSize: 14, TextColor: #96a9be, Wrap: true); Text: ""; Visible: false; }
