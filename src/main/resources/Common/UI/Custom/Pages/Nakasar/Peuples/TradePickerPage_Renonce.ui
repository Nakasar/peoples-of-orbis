        LayoutMode: Left;
        Anchor: (Height: 52, Bottom: 6);
        Button #Pick0 {
          FlexWeight: 1;
          Anchor: (Right: 6);
          Style: $C.@SecondaryButtonStyle;
          LayoutMode: Left;
          Padding: (Horizontal: 8);
          ItemIcon #Pick0Icon { Anchor: (Width: 32, Height: 32, Top: 10, Right: 8); ShowItemTooltip: true; }
          Group {
            LayoutMode: Top;
            FlexWeight: 1;
            Label #Pick0Name { Anchor: (Height: 20, Top: 6); Style: (FontSize: 13, RenderBold: true, TextColor: #e6edf3, VerticalAlignment: Center); Text: ""; }
            Label #Pick0Sub { Anchor: (Height: 16); Style: (FontSize: 11, TextColor: #96a9be, VerticalAlignment: Center); Text: ""; }
          }
          Label #Pick0Grade { Anchor: (Width: 34); Style: (FontSize: 13, RenderBold: true, TextColor: #e8c46a, HorizontalAlignment: End, VerticalAlignment: Center); Text: ""; }
        }
