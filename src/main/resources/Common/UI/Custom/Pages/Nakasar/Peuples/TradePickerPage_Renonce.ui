$C = "../../../Common.ui";

// Généré par tools/generate_trade.py (thème Renonce) : ne pas modifier à la main.

@Small = LabelStyle(FontSize: 12, TextColor: #96a9be, VerticalAlignment: Center);

@Bar = ProgressBar {
  Background: "../../../Common/ProgressBar.png";
  BarTexturePath: "Board/Bar_Renonce.png";
  Value: 0;
};

$C.@PageOverlay {
  LayoutMode: Middle;

  $C.@DecoratedContainer {
    Anchor: (Width: 760, Height: 560);

    #Title {
      Group {
        LayoutMode: Center;
        Label #PageTitle { Style: (...$C.@TitleStyle, FontSize: 15, TextColor: #bfe2ee); }
      }
    }

    #Content {
      LayoutMode: Top;
      Padding: (Full: 14, Top: 10);
      Group {
        LayoutMode: Left;
        Anchor: (Height: 30, Bottom: 10);
        Group #GradeAll {
          LayoutMode: Full;
          Anchor: (Width: 110, Height: 30, Right: 6);
          $C.@SmallSecondaryTextButton #GradeAllButton { @Text = ""; @Anchor = Anchor(Full: 0); }
          Group #GradeAllOn {
            LayoutMode: Full;
            Anchor: (Full: 0);
            Background: (Color: #8fd0ea);
            Visible: false;
            Label #GradeAllLabel { Anchor: (Full: 0); Style: (FontSize: 12, RenderBold: true, TextColor: #10180e, HorizontalAlignment: Center, VerticalAlignment: Center); Text: ""; }
          }
        }
        Group #GradeCommon {
          LayoutMode: Full;
          Anchor: (Width: 110, Height: 30, Right: 6);
          $C.@SmallSecondaryTextButton #GradeCommonButton { @Text = ""; @Anchor = Anchor(Full: 0); }
          Group #GradeCommonOn {
            LayoutMode: Full;
            Anchor: (Full: 0);
            Background: (Color: #8fd0ea);
            Visible: false;
            Label #GradeCommonLabel { Anchor: (Full: 0); Style: (FontSize: 12, RenderBold: true, TextColor: #10180e, HorizontalAlignment: Center, VerticalAlignment: Center); Text: ""; }
          }
        }
        Group #GradeFine {
          LayoutMode: Full;
          Anchor: (Width: 110, Height: 30, Right: 6);
          $C.@SmallSecondaryTextButton #GradeFineButton { @Text = ""; @Anchor = Anchor(Full: 0); }
          Group #GradeFineOn {
            LayoutMode: Full;
            Anchor: (Full: 0);
            Background: (Color: #8fd0ea);
            Visible: false;
            Label #GradeFineLabel { Anchor: (Full: 0); Style: (FontSize: 12, RenderBold: true, TextColor: #10180e, HorizontalAlignment: Center, VerticalAlignment: Center); Text: ""; }
          }
        }
        Group #GradeLuxury {
          LayoutMode: Full;
          Anchor: (Width: 110, Height: 30, Right: 6);
