          Group #TabPeopleOn {
            LayoutMode: CenterMiddle;
            Anchor: (Full: 0);
            Background: (Color: #e0773e);
            Visible: true;
            Group { Anchor: (Width: 24, Height: 24); Background: (TexturePath: "Board/Tab_People.png", Color: #10180e); }
          }
        }
        Group {
          LayoutMode: Full;
          FlexWeight: 1;
          Padding: (Left: 8);
          Label #TabNameBoard { Anchor: (Full: 0); Style: (FontSize: 16, RenderBold: true, RenderUppercase: true, TextColor: #e0773e, VerticalAlignment: Center); Text: ""; Visible: false; }
          Label #TabNamePlots { Anchor: (Full: 0); Style: (FontSize: 16, RenderBold: true, RenderUppercase: true, TextColor: #e0773e, VerticalAlignment: Center); Text: ""; Visible: false; }
          Label #TabNameAnnexes { Anchor: (Full: 0); Style: (FontSize: 16, RenderBold: true, RenderUppercase: true, TextColor: #e0773e, VerticalAlignment: Center); Text: ""; Visible: false; }
          Label #TabNameWorks { Anchor: (Full: 0); Style: (FontSize: 16, RenderBold: true, RenderUppercase: true, TextColor: #e0773e, VerticalAlignment: Center); Text: ""; Visible: false; }
          Label #TabNameWorld { Anchor: (Full: 0); Style: (FontSize: 16, RenderBold: true, RenderUppercase: true, TextColor: #e0773e, VerticalAlignment: Center); Text: ""; Visible: false; }
          Label #TabNameDomain { Anchor: (Full: 0); Style: (FontSize: 16, RenderBold: true, RenderUppercase: true, TextColor: #e0773e, VerticalAlignment: Center); Text: ""; Visible: false; }
          Label #TabNameTrade { Anchor: (Full: 0); Style: (FontSize: 16, RenderBold: true, RenderUppercase: true, TextColor: #e0773e, VerticalAlignment: Center); Text: ""; Visible: false; }
          Label #TabNamePeople { Anchor: (Full: 0); Style: (FontSize: 16, RenderBold: true, RenderUppercase: true, TextColor: #e0773e, VerticalAlignment: Center); Text: ""; Visible: true; }
        }
        Label #Clock { Anchor: (Width: 110); Style: (FontSize: 14, RenderBold: true, TextColor: #96a9be, HorizontalAlignment: End, VerticalAlignment: Center); Text: ""; }
      }
      Group { Anchor: (Height: 2, Bottom: 12); Background: (Color: #e0773e); }
      Group {
        LayoutMode: Left;
        FlexWeight: 1;
        Group #Left {
          LayoutMode: Top;
          Anchor: (Width: 590, Right: 14);
          Label #Census { Anchor: (Height: 22); Style: (FontSize: 14, RenderBold: true, TextColor: #e8c46a, VerticalAlignment: Center); Text: ""; }
          Label #ListHeader { Anchor: (Height: 22, Top: 6, Bottom: 6); Style: @Section; Text: ""; }
          Group #Row0 {
            LayoutMode: Left;
            Anchor: (Height: 48, Bottom: 4);
            Padding: (Horizontal: 12, Vertical: 3);
            Background: (Color: #4a2216(0.55));
            Group {
              LayoutMode: Top;
              FlexWeight: 1;
              Label #RowName0 { Anchor: (Height: 20); Style: (FontSize: 15, RenderBold: true, TextColor: #e0773e, VerticalAlignment: Center); Text: ""; }
              Label #RowLine0 { Anchor: (Height: 22); Style: (FontSize: 13, TextColor: #96a9be, Wrap: true); Text: ""; }
            }
            $C.@SmallSecondaryTextButton #RowOrient0 { @Text = ""; @Anchor = Anchor(Width: 120, Height: 30, Left: 8, Top: 6); }
          }
          Group #Row1 {
            LayoutMode: Left;
            Anchor: (Height: 48, Bottom: 4);
            Padding: (Horizontal: 12, Vertical: 3);
            Background: (Color: #4a2216(0.55));
            Group {
              LayoutMode: Top;
              FlexWeight: 1;
              Label #RowName1 { Anchor: (Height: 20); Style: (FontSize: 15, RenderBold: true, TextColor: #e0773e, VerticalAlignment: Center); Text: ""; }
              Label #RowLine1 { Anchor: (Height: 22); Style: (FontSize: 13, TextColor: #96a9be, Wrap: true); Text: ""; }
            }
            $C.@SmallSecondaryTextButton #RowOrient1 { @Text = ""; @Anchor = Anchor(Width: 120, Height: 30, Left: 8, Top: 6); }
