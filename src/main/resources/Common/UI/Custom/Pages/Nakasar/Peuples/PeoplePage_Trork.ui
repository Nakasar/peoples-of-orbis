$C = "../../../Common.ui";

// Généré par tools/generate_population.py (thème Trork) : ne pas modifier à la main.

@Accent = #e0773e;
@Section = LabelStyle(FontSize: 15, RenderBold: true, RenderUppercase: true, TextColor: #e8b48a, VerticalAlignment: Center);
@Body = LabelStyle(FontSize: 14, TextColor: #c9d1d9, Wrap: true);
@SmallWrap = LabelStyle(FontSize: 13, TextColor: #96a9be, Wrap: true);

$C.@PageOverlay {
  LayoutMode: Middle;

  $C.@DecoratedContainer {
    Anchor: (Width: 1060, Height: 840);

    #Title {
      Group {
        LayoutMode: Center;
        Group #TitleEmblem { Anchor: (Width: 26, Height: 26, Right: 8); Background: (TexturePath: "../../Memories/categories/Trork.png", Color: #e0773e); }
        Label #PageTitle { Style: (...$C.@TitleStyle, FontSize: 16, TextColor: #e8b48a); }
      }
    }

    #Content {
      LayoutMode: Top;
      Padding: (Full: 17, Top: 12);
      Group #Tabs {
        LayoutMode: Left;
        Anchor: (Height: 38);
        Group #TabBoard {
          LayoutMode: Full;
          Anchor: (Width: 52, Height: 38, Right: 6);
          Group #TabBoardOff {
            LayoutMode: Full;
            Anchor: (Full: 0);
            Visible: true;
            Button #TabBoardButton {
              Anchor: (Full: 0);
              Style: $C.@SecondaryButtonStyle;
              LayoutMode: CenterMiddle;
              TextTooltipStyle: $C.@DefaultTextTooltipStyle;
              Group { Anchor: (Width: 24, Height: 24); Background: (TexturePath: "Board/Tab_Board.png", Color: #c9d1d9); }
            }
          }
          Group #TabBoardOn {
            LayoutMode: CenterMiddle;
            Anchor: (Full: 0);
            Background: (Color: #e0773e);
            Visible: false;
            Group { Anchor: (Width: 24, Height: 24); Background: (TexturePath: "Board/Tab_Board.png", Color: #10180e); }
          }
        }
        Group #TabPlots {
          LayoutMode: Full;
          Anchor: (Width: 52, Height: 38, Right: 6);
          Group #TabPlotsOff {
            LayoutMode: Full;
            Anchor: (Full: 0);
            Visible: true;
            Button #TabPlotsButton {
              Anchor: (Full: 0);
              Style: $C.@SecondaryButtonStyle;
              LayoutMode: CenterMiddle;
              TextTooltipStyle: $C.@DefaultTextTooltipStyle;
              Group { Anchor: (Width: 24, Height: 24); Background: (TexturePath: "Board/Tab_Plots.png", Color: #c9d1d9); }
            }
          }
          Group #TabPlotsOn {
            LayoutMode: CenterMiddle;
            Anchor: (Full: 0);
            Background: (Color: #e0773e);
            Visible: false;
            Group { Anchor: (Width: 24, Height: 24); Background: (TexturePath: "Board/Tab_Plots.png", Color: #10180e); }
          }
        }
        Group #TabAnnexes {
          LayoutMode: Full;
          Anchor: (Width: 52, Height: 38, Right: 6);
          Group #TabAnnexesOff {
            LayoutMode: Full;
            Anchor: (Full: 0);
            Visible: true;
            Button #TabAnnexesButton {
              Anchor: (Full: 0);
              Style: $C.@SecondaryButtonStyle;
              LayoutMode: CenterMiddle;
              TextTooltipStyle: $C.@DefaultTextTooltipStyle;
              Group { Anchor: (Width: 24, Height: 24); Background: (TexturePath: "Board/Tab_Annexes.png", Color: #c9d1d9); }
            }
          }
          Group #TabAnnexesOn {
            LayoutMode: CenterMiddle;
            Anchor: (Full: 0);
            Background: (Color: #e0773e);
            Visible: false;
            Group { Anchor: (Width: 24, Height: 24); Background: (TexturePath: "Board/Tab_Annexes.png", Color: #10180e); }
          }
        }
        Group #TabWorks {
          LayoutMode: Full;
          Anchor: (Width: 52, Height: 38, Right: 6);
