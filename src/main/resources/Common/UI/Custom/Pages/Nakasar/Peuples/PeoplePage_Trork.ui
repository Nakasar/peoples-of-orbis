            Anchor: (Full: 0);
            Background: (Color: #e0773e);
            Visible: false;
            Group { Anchor: (Width: 24, Height: 24); Background: (TexturePath: "Board/Tab_World.png", Color: #10180e); }
          }
        }
        Group #TabDomain {
          LayoutMode: Full;
          Anchor: (Width: 52, Height: 38, Right: 6);
          Group #TabDomainOff {
            LayoutMode: Full;
            Anchor: (Full: 0);
            Visible: true;
            Button #TabDomainButton {
