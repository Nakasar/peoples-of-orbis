              Anchor: (Full: 0);
              Style: $C.@SecondaryButtonStyle;
              LayoutMode: CenterMiddle;
              TextTooltipStyle: $C.@DefaultTextTooltipStyle;
              Group { Anchor: (Width: 24, Height: 24); Background: (TexturePath: "Board/Tab_Works.png", Color: #c9d1d9); }
            }
          }
          Group #TabWorksOn {
            LayoutMode: CenterMiddle;
            Anchor: (Full: 0);
            Background: (Color: #e0773e);
            Visible: false;
            Group { Anchor: (Width: 24, Height: 24); Background: (TexturePath: "Board/Tab_Works.png", Color: #10180e); }
          }
        }
        Group #TabWorld {
          LayoutMode: Full;
          Anchor: (Width: 52, Height: 38, Right: 6);
          Group #TabWorldOff {
            LayoutMode: Full;
            Anchor: (Full: 0);
            Visible: true;
            Button #TabWorldButton {
              Anchor: (Full: 0);
              Style: $C.@SecondaryButtonStyle;
              LayoutMode: CenterMiddle;
