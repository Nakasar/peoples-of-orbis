          }
          Group { FlexWeight: 1; }
          Group {
            LayoutMode: Left;
            Anchor: (Height: 30, Top: 6);
            $C.@SmallSecondaryTextButton #Prev { @Text = ""; @Anchor = Anchor(Width: 110, Height: 30); }
            Label #PageLine { Style: (FontSize: 13, TextColor: #96a9be, HorizontalAlignment: Center, VerticalAlignment: Center); Text: ""; FlexWeight: 1; }
            $C.@SmallSecondaryTextButton #Next { @Text = ""; @Anchor = Anchor(Width: 110, Height: 30); }
          }
        }
        Group #Right {
          LayoutMode: Top;
          FlexWeight: 1;
          Group {
            LayoutMode: Top;
            Anchor: (Bottom: 8);
            Padding: (Horizontal: 14, Vertical: 8);
            Background: (Color: #4a2216(0.75));
            Label #BirthHeader { Anchor: (Height: 22); Style: @Section; Text: ""; }
            Label #BirthLine { Anchor: (Height: 52, Top: 2); Style: @SmallWrap; Text: ""; }
            Group {
              LayoutMode: Left;
              Anchor: (Height: 30, Top: 4);
              $C.@SmallSecondaryTextButton #Name0 { @Text = ""; @Anchor = Anchor(Width: 118, Height: 30, Right: 6); }
