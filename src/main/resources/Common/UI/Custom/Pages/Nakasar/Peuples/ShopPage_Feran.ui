            ItemIcon #RowPriceIcon6 { Anchor: (Width: 24, Height: 24, Top: 16, Right: 12); ShowItemTooltip: true; }
            $C.@SmallSecondaryTextButton #RowLess6 { @Text = "-"; @Anchor = Anchor(Width: 30, Height: 30, Top: 13); }
            Label #RowCount6 { Anchor: (Width: 34); Style: (FontSize: 14, RenderBold: true, TextColor: #e6edf3, HorizontalAlignment: Center, VerticalAlignment: Center); Text: ""; }
            $C.@SmallSecondaryTextButton #RowMore6 { @Text = "+"; @Anchor = Anchor(Width: 30, Height: 30, Top: 13, Right: 10); }
            $C.@TextButton #RowTrade6 { @Text = ""; @Anchor = Anchor(Width: 130, Height: 38, Top: 9); }
          }
        }
      }
    }
  }
}

$C.@BackButton {}
