$C = "../../../Common.ui";

// Généré par tools/generate_shop_ui.py (thème Feran) : ne pas modifier à la main.

@Section = LabelStyle(FontSize: 12, RenderBold: true, RenderUppercase: true, TextColor: #96a9be, VerticalAlignment: Center);
@Name = LabelStyle(FontSize: 14, RenderBold: true, TextColor: #e6edf3, VerticalAlignment: Center);
@Small = LabelStyle(FontSize: 12, TextColor: #96a9be, VerticalAlignment: Center);
@SmallRight = LabelStyle(FontSize: 12, TextColor: #96a9be, HorizontalAlignment: End, VerticalAlignment: Center);

@Bar = ProgressBar {
  Background: "../../../Common/ProgressBar.png";
  BarTexturePath: "Board/Bar_Feran.png";
  Value: 0;
};

$C.@PageOverlay {
  LayoutMode: Middle;

  $C.@DecoratedContainer {
    Anchor: (Width: 1060, Height: 720);

    #Title {
      Group {
        LayoutMode: Center;
        Group #TitleEmblem { Anchor: (Width: 26, Height: 26, Right: 8); Background: (TexturePath: "../../Memories/categories/Feran.png", Color: #e6b552); }
        Label #PageTitle { Style: (...$C.@TitleStyle, FontSize: 16, TextColor: #ecd29a); }
      }
    }

    #Content {
      LayoutMode: Top;
      Padding: (Full: 14, Top: 10);
      Group {
        LayoutMode: Left;
        Anchor: (Height: 60, Bottom: 10);
        Padding: (Horizontal: 12);
        Background: (Color: #4a3a17(0.7));
        Group {
          LayoutMode: Full;
          Anchor: (Width: 46, Height: 46, Top: 7, Right: 10);
          Background: (TexturePath: "../../../Common/IngredientSlot.png", Border: 24);
          ItemIcon #HeadIcon { Anchor: (Full: 6); ShowItemTooltip: false; }
        }
        Group {
          LayoutMode: Top;
          Anchor: (Width: 300);
          Label #HeadName { Anchor: (Height: 26, Top: 8); Style: (FontSize: 17, RenderBold: true, TextColor: #ecd29a, VerticalAlignment: Center); Text: ""; }
          Label #HeadSub { Anchor: (Height: 18); Style: @Small; Text: ""; }
        }
        Group #RankBox {
          LayoutMode: Top;
          Anchor: (Width: 260, Left: 14);
          Label #RankLine { Anchor: (Height: 20, Top: 12); Style: @Small; Text: ""; }
          @Bar #RankBar { Anchor: (Height: 8, Top: 4); }
        }
        Group { FlexWeight: 1; }
        Group #Wallet {
          LayoutMode: Left;
          Anchor: (Height: 40, Top: 10);
          Padding: (Horizontal: 10);
          Background: (Color: #000000(0.25));
          ItemIcon #WalletIcon { Anchor: (Width: 30, Height: 30, Top: 5, Right: 8); ShowItemTooltip: true; }
          Label #WalletCount { Anchor: (Right: 6); Style: (FontSize: 19, RenderBold: true, TextColor: #f2ead2, VerticalAlignment: Center); Text: ""; }
          Label #WalletName { Style: @Small; Text: ""; }
        }
      }
      Group {
        LayoutMode: Left;
        FlexWeight: 1;
        Group #Rail {
          LayoutMode: Top;
          Anchor: (Width: 236, Right: 12);
          Padding: (Full: 8);
          Background: (Color: #4a3a17(0.45));
          Label #RailHeader { Anchor: (Height: 22, Bottom: 4); Style: @Section; Text: ""; }
          Group #Stand0 {
            LayoutMode: Left;
            Anchor: (Height: 50, Bottom: 4);
            Group #StandOn0 { Anchor: (Width: 4); Background: (Color: #e6b552); Visible: false; }
            Button #StandButton0 {
              FlexWeight: 1;
              Style: $C.@SecondaryButtonStyle;
              LayoutMode: Left;
              Padding: (Horizontal: 6);
              ItemIcon #StandIcon0 { Anchor: (Width: 30, Height: 30, Top: 10, Right: 8); ShowItemTooltip: false; }
              Group {
                LayoutMode: Top;
                FlexWeight: 1;
                Label #StandName0 { Anchor: (Height: 20, Top: 5); Style: (FontSize: 13, RenderBold: true, TextColor: #e6edf3, VerticalAlignment: Center); Text: ""; }
                Label #StandSub0 { Anchor: (Height: 16); Style: (FontSize: 11, TextColor: #96a9be, VerticalAlignment: Center); Text: ""; }
              }
            }
          }
          Group #Stand1 {
            LayoutMode: Left;
            Anchor: (Height: 50, Bottom: 4);
            Group #StandOn1 { Anchor: (Width: 4); Background: (Color: #e6b552); Visible: false; }
            Button #StandButton1 {
              FlexWeight: 1;
