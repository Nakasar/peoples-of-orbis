          FlexWeight: 1;
          Group {
            LayoutMode: Left;
            Anchor: (Height: 32, Bottom: 8);
            Group #Tab0 {
              LayoutMode: Full;
              Anchor: (Width: 150, Height: 32, Right: 6);
              $C.@SmallSecondaryTextButton #TabButton0 { @Text = ""; @Anchor = Anchor(Full: 0); }
              Group #TabOn0 {
