            FlexWeight: 1;
            Label #RouteName0 { Anchor: (Height: 20); Style: (FontSize: 15, RenderBold: true, TextColor: #8fd0ea, VerticalAlignment: Center); Text: ""; }
            Label #RouteState0 { Anchor: (Height: 18); Style: @Small; Text: ""; }
            Group {
              LayoutMode: Left;
              Anchor: (Height: 26, Top: 4);
              Label #RouteOutLabel0 { Anchor: (Width: 90); Style: @Small; Text: ""; }
              $C.@SmallSecondaryTextButton #RouteOut0C0 { @Text = ""; @Anchor = Anchor(Width: 190, Height: 26, Right: 6); }
