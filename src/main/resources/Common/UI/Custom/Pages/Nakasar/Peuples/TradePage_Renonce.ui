$C = "../../../Common.ui";

// Généré par tools/generate_trade.py (thème Renonce) : ne pas modifier à la main.

@Accent = #8fd0ea;
@Section = LabelStyle(FontSize: 15, RenderBold: true, RenderUppercase: true, TextColor: #bfe2ee, VerticalAlignment: Center);
@Body = LabelStyle(FontSize: 14, TextColor: #c9d1d9, Wrap: true);
@Small = LabelStyle(FontSize: 13, TextColor: #96a9be, VerticalAlignment: Center);
@SmallWrap = LabelStyle(FontSize: 13, TextColor: #96a9be, Wrap: true);
@Mark = LabelStyle(FontSize: 11, RenderBold: true, TextColor: #7f93a8, HorizontalAlignment: Center, VerticalAlignment: Center);

$C.@PageOverlay {
  LayoutMode: Middle;

  $C.@DecoratedContainer {
    Anchor: (Width: 1060, Height: 840);

    #Title {
      Group {
        LayoutMode: Center;
        Group #TitleEmblem { Anchor: (Width: 26, Height: 26, Right: 8); Background: (TexturePath: "../../Memories/categories/Outlander.png", Color: #8fd0ea); }
        Label #PageTitle { Style: (...$C.@TitleStyle, FontSize: 16, TextColor: #bfe2ee); }
      }
    }

    #Content {
      LayoutMode: Top;
      Padding: (Full: 17, Top: 12);
      Group #Tabs {
        LayoutMode: Left;
        Anchor: (Height: 38);
        Group #TabBoard {
          LayoutMode: Full;
          Anchor: (Width: 52, Height: 38, Right: 6);
          Group #TabBoardOff {
            LayoutMode: Full;
            Anchor: (Full: 0);
            Visible: true;
            Button #TabBoardButton {
              Anchor: (Full: 0);
              Style: $C.@SecondaryButtonStyle;
              LayoutMode: CenterMiddle;
              TextTooltipStyle: $C.@DefaultTextTooltipStyle;
              Group { Anchor: (Width: 24, Height: 24); Background: (TexturePath: "Board/Tab_Board.png", Color: #c9d1d9); }
            }
          }
          Group #TabBoardOn {
            LayoutMode: CenterMiddle;
            Anchor: (Full: 0);
            Background: (Color: #8fd0ea);
            Visible: false;
            Group { Anchor: (Width: 24, Height: 24); Background: (TexturePath: "Board/Tab_Board.png", Color: #10180e); }
          }
        }
        Group #TabBuild {
          LayoutMode: Full;
          Anchor: (Width: 52, Height: 38, Right: 6);
          Group #TabBuildOff {
            LayoutMode: Full;
            Anchor: (Full: 0);
            Visible: true;
            Button #TabBuildButton {
              Anchor: (Full: 0);
              Style: $C.@SecondaryButtonStyle;
              LayoutMode: CenterMiddle;
              TextTooltipStyle: $C.@DefaultTextTooltipStyle;
              Group { Anchor: (Width: 24, Height: 24); Background: (TexturePath: "Board/Tab_Build.png", Color: #c9d1d9); }
            }
          }
          Group #TabBuildOn {
            LayoutMode: CenterMiddle;
            Anchor: (Full: 0);
            Background: (Color: #8fd0ea);
            Visible: false;
            Group { Anchor: (Width: 24, Height: 24); Background: (TexturePath: "Board/Tab_Build.png", Color: #10180e); }
          }
        }
        Group #TabWorld {
