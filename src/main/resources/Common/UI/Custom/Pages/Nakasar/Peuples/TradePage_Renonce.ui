              Anchor: (Full: 0);
              Style: $C.@SecondaryButtonStyle;
              LayoutMode: CenterMiddle;
              TextTooltipStyle: $C.@DefaultTextTooltipStyle;
              Group { Anchor: (Width: 24, Height: 24); Background: (TexturePath: "Board/Tab_World.png", Color: #c9d1d9); }
            }
