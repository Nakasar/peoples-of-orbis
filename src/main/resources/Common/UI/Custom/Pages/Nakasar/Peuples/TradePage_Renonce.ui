          Group #TabTradeOn {
            LayoutMode: CenterMiddle;
            Anchor: (Full: 0);
            Background: (Color: #8fd0ea);
            Visible: true;
            Group { Anchor: (Width: 24, Height: 24); Background: (TexturePath: "Board/Tab_Trade.png", Color: #10180e); }
          }
        }
        Group #TabPeople {
          LayoutMode: Full;
