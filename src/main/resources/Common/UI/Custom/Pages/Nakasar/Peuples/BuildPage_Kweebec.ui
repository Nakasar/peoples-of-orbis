$C = "../../../Common.ui";

// Généré par tools/generate_build_tab.py (thème Kweebec) : ne pas modifier à la main.

@Accent = #9ed36a;
@Body = LabelStyle(FontSize: 13, TextColor: #c9d1d9, Wrap: true);
@Small = LabelStyle(FontSize: 12, TextColor: #96a9be);
@SmallWrap = LabelStyle(FontSize: 12, TextColor: #96a9be, Wrap: true);
@Head = LabelStyle(FontSize: 12, RenderBold: true, RenderUppercase: true, TextColor: #96a9be);
@Count = LabelStyle(FontSize: 12, RenderBold: true, TextColor: #e8c46a, HorizontalAlignment: Center, VerticalAlignment: Center);
@Qty = LabelStyle(FontSize: 12, RenderBold: true, TextColor: #d9e2ec, VerticalAlignment: Center);

$C.@PageOverlay {
  LayoutMode: Middle;

  $C.@DecoratedContainer {
    Anchor: (Width: 1060, Height: 840);

    #Title {
      Group {
        LayoutMode: Center;
        Group #TitleEmblem { Anchor: (Width: 26, Height: 26, Right: 8); Background: (TexturePath: "../../Memories/categories/Kweebec.png", Color: #9ed36a); }
        Label #PageTitle { Style: (...$C.@TitleStyle, FontSize: 16, TextColor: #d9c48a); }
      }
    }

    #Content {
      LayoutMode: Top;
      Padding: (Full: 17, Top: 12);
      Group #Tabs {
        LayoutMode: Left;
        Anchor: (Height: 38);
        Group #TabBoard {
          LayoutMode: Full;
          Anchor: (Width: 52, Height: 38, Right: 6);
          Group #TabBoardOff {
            LayoutMode: Full;
            Anchor: (Full: 0);
            Visible: true;
            Button #TabBoardButton {
              Anchor: (Full: 0);
              Style: $C.@SecondaryButtonStyle;
              LayoutMode: CenterMiddle;
              TextTooltipStyle: $C.@DefaultTextTooltipStyle;
              Group { Anchor: (Width: 24, Height: 24); Background: (TexturePath: "Board/Tab_Board.png", Color: #c9d1d9); }
            }
          }
          Group #TabBoardOn {
            LayoutMode: CenterMiddle;
            Anchor: (Full: 0);
            Background: (Color: #9ed36a);
            Visible: false;
            Group { Anchor: (Width: 24, Height: 24); Background: (TexturePath: "Board/Tab_Board.png", Color: #10180e); }
          }
        }
        Group #TabBuild {
          LayoutMode: Full;
          Anchor: (Width: 52, Height: 38, Right: 6);
          Group #TabBuildOff {
            LayoutMode: Full;
            Anchor: (Full: 0);
            Visible: false;
            Button #TabBuildButton {
              Anchor: (Full: 0);
              Style: $C.@SecondaryButtonStyle;
              LayoutMode: CenterMiddle;
              TextTooltipStyle: $C.@DefaultTextTooltipStyle;
              Group { Anchor: (Width: 24, Height: 24); Background: (TexturePath: "Board/Tab_Build.png", Color: #c9d1d9); }
            }
          }
          Group #TabBuildOn {
            LayoutMode: CenterMiddle;
            Anchor: (Full: 0);
            Background: (Color: #9ed36a);
